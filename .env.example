# Expo app — คัดลอกเป็น .env แล้วใส่ค่าจริง
#
# Production (ผู้ทดสอบสแกน QR จาก Expo Go): ชี้ไป backend ที่ deploy แล้ว
EXPO_PUBLIC_API_URL=https://ingreen-backend.onrender.com
#
# Dev บน LAN (ทดสอบในเครื่อง): ใช้ IP ของเครื่องที่รัน backend (ไม่ใช่ localhost)
#   ดู IP ด้วย: ipconfig getifaddr en0   (mac)
# EXPO_PUBLIC_API_URL=http://192.168.1.50:5001
